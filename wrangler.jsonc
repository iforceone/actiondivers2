// Cloudflare config for the SITE Worker (actiondivers2).
// The API Worker has its own config in worker-api/wrangler.toml.
//
// This exists so builds are deterministic. Without it, `wrangler deploy` falls
// back to interactive auto-detection that guesses these values at build time,
// while `wrangler versions upload` — what Cloudflare runs for non-production
// branch builds — has no such fallback and fails with "Missing entry-point to
// Worker script or to assets directory".
//
// A small Worker fronts the static assets (site-worker/index.ts) so unknown URLs
// return a real 404 instead of the single-page app's 200 index.html, while the
// app-only routes (customer links, forms, staff portal) still load.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "actiondivers2",
  "main": "site-worker/index.ts",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve files directly; the Worker only runs for page navigations.
    "run_worker_first": ["/*", "!/assets/*", "!/images/*"],
    // The Worker decides what an unknown path means (see site-worker/index.ts).
    "not_found_handling": "none"
  }
}
